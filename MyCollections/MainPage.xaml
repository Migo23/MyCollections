<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyCollections.MainPage"
             Title="Moje Kolekcje">

    <VerticalStackLayout Padding="20" Spacing="15">
        <Label Text="Moje Kolekcje" FontSize="28" FontAttributes="Bold" />
        <CollectionView x:Name="CollectionsView" SelectionMode="Single">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="15" Margin="5" BackgroundColor="{StaticResource PrimaryColor}" CornerRadius="8">
                        <Label Text="{Binding Name}" FontSize="20" />
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Text="Dodaj kolekcję" Clicked="OnAddClicked" />
    </VerticalStackLayout>

</ContentPage>
